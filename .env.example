# ===== Servidor do cliente (docker compose) =====
DOMINIO=promopost.com.br
# senha forte do banco (só usada dentro do servidor)
DB_PASSWORD=
# texto aleatório longo (ex.: openssl rand -hex 32)
PAYLOAD_SECRET=
NODE_ENV=production
# libera indexação no Google
SITE_ENV=production
SITE_URL=https://promopost.com.br

# Formulários — e-mail (escolha um provedor)
# smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="PromoPost <contato@promopost.com.br>"
# no servidor final: e-mail do cliente
EMAIL_TO=arimaia1976@gmail.com
EMAIL_SUBJECT="Contato via site"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Formulários — planilha/automação (opcional, ex.: webhook do Make → Google Sheets)
FORM_WEBHOOK_URL=
